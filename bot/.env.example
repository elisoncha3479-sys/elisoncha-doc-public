 # .env.example — скопируйте в .env и заполните ключи без значений.
  # .env в git НЕ коммитится. Реальных секретов здесь нет.
  #
  # ВАЖНО: комментарии — ТОЛЬКО на отдельных строках. НЕ дописывайте
  # текст после KEY=значение: парсер возьмёт его в значение и бот упадёт.
  # Необязательные ключи закомментированы (#) — код берёт дефолты сам.

  # --- Обязательное ---
  # ключ Anthropic API: console.anthropic.com/settings/keys
  ANTHROPIC_API_KEY=
  # токен бота из @BotFather
  TELEGRAM_BOT_TOKEN=

  # --- Чаты Telegram ---
  # личный chat_id владельца (узнать командой /whoami)
  OWNER_CHAT_ID=
  # chat_id общего чата. ПУСТО = setup-режим (бот подскажет chat_id)
  GROUP_CHAT_ID=
  # Telegram user_id пациента (узнать командой /myid)
  PATIENT_TG_USER_ID=

  # --- Личность пациента (заполняется онбордингом) ---
  PATIENT_FULL_NAME=
  PATIENT_ADDRESS_NAME=
  PATIENT_DOB=
  PATIENT_CITY=
  # f или m 
  PATIENT_GENDER=f
  PATIENT_INBOX_DIR=PATIENT

  # --- Модели (дефолты в коде; раскомментируйте чтобы поменять) ---
  # MULTI_AGENT=1
  # VALIDATOR_MODEL=
  # DIGEST_MODEL=
  # PATIENT_MSG_MODEL=
  # RECONCILE_MODEL=
  # HISTORICAL_CHECK_MODEL=
  # HISTORY_REGEN_MODEL=
  # PROFILE_REFRESHER_MODEL=
  # PROFILE_REFRESHER_MAX_TOKENS=
  # ONBOARDING_MODEL=

  # --- Поведение пайплайна (дефолты в коде) ---
  # OCR_ENABLED=1
  # BATCH_WINDOW=
  # DOWNLOAD_RETRIES=
  # DOC_TEXT_LIMIT=40000
  # HISTORY_LIMIT=15000
  # REFRESH_PERDOC_LIMIT=
  # RECONCILE_THROTTLE_SECONDS=

  # --- Health / watchdog (дефолты в коде) ---
  # HEALTH_HOST=127.0.0.1
  # HEALTH_PORT=8080
  # HEALTH_HEARTBEAT_INTERVAL=
  # HEALTH_WATCHDOG_INTERVAL=
  # HEALTH_STALE_AFTER=
  # HEALTH_KILL_AFTER=